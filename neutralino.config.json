{
  "logging": {
    "enabled": true,
    "writeToLogFile": false
  },
  "applicationId": "localimagesearch",
  "version": "0.3.0",
  "defaultMode": "window",
  "documentRoot": "/dist-vue/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "enableExtensions": true,
  "nativeAllowList": [
    "app.*",
    "os.*",
    "filesystem.*",
    "server.*",
    "storage.*",
    "debug.log",
    "extensions.*",
    "events.*"
  ],
  "extensions": [
    {
      "id": "ai.search.extension",
      "commandWindows": "extensions\\ai-search-extension.exe",
      "commandLinux": "${NL_PATH}/extensions/ai-search-extension",
      "commandDarwin": "${NL_PATH}/extensions/ai-search-extension"
    }
  ],
  "modes": {
    "window": {
      "title": "魔王图片搜索",
      "width": 1200,
      "height": 800,
      "minWidth": 900,
      "minHeight": 600,
      "fullScreen": false,
      "alwaysOnTop": false,
      "enableInspector": true,
      "borderless": false,
      "maximize": true,
      "hidden": false,
      "resizable": true,
      "icon": "/public/favicon.svg",
      "exitProcessOnClose": true,
      "useSavedState": true,
      "center": true,
      "injectGlobals": true,
      "injectClientLibrary": true
    }
  },
  "cli": {
    "binaryName": "localimagesearch",
    "resourcesPath": "/dist-vue/",
    "frontendLibrary": {
      "patchFile": "/index.html",
      "devUrl": "http://localhost:5173",
      "projectPath": "/",
      "initCommand": "pnpm install",
      "devCommand": "pnpm dev",
      "buildCommand": "pnpm build"
    },
    "binaryVersion": "6.7.0"
  }
}